/* pages/test/test.wxss */

.container {
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 进度信息 */
.progress-info {
  width: 100%;
  margin-bottom: 30rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 10rpx;
}

.progress-bar {
  width: 100%;
  height: 10rpx;
  background-color: #e0e0e0;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #4a6dff;
  border-radius: 5rpx;
  transition: width 0.3s;
}

/* 得分显示 */
.score-display {
  margin-bottom: 40rpx;
}

.score-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 问题容器 */
.question-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 音频按钮 */
.audio-button {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background-color: #4a6dff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 50rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.audio-button .iconfont {
  font-size: 80rpx;
  color: #fff;
  margin-bottom: 10rpx;
}

.audio-text {
  font-size: 24rpx;
  color: #fff;
}

/* 选项容器 */
.options-container {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.option-item {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s;
}

.option-hover {
  background-color: #f0f0f0;
}

.option-kana {
  font-size: 60rpx;
  color: #333;
}

.correct {
  background-color: #4cd964;
  color: #fff;
}

.wrong {
  background-color: #ff3b30;
  color: #fff;
}

.correct .option-kana, .wrong .option-kana {
  color: #fff;
}

/* 结果容器 */
.result-container {
  width: 100%;
  background-color: #fff;
  border-radius: 15rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.result-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.result-content {
  margin-bottom: 30rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-label {
  color: #666;
  font-size: 28rpx;
}

.result-value {
  color: #333;
  font-size: 28rpx;
  font-weight: bold;
}

.result-message {
  text-align: center;
  margin: 30rpx 0;
}

.result-message-text {
  font-size: 32rpx;
  font-weight: bold;
}

.excellent {
  color: #4cd964;
}

.good {
  color: #34aadc;
}

.average {
  color: #ff9500;
}

.poor {
  color: #ff3b30;
}

.wrong-answers-info {
  background-color: #fff9e6;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.wrong-answers-text {
  font-size: 24rpx;
  color: #ff9500;
}

.result-buttons {
  display: flex;
  justify-content: space-between;
}

.btn {
  flex: 1;
  margin: 0 10rpx;
  font-size: 28rpx;
  border-radius: 10rpx;
}

.restart-btn {
  background-color: #4a6dff;
  color: #fff;
}

.review-btn {
  background-color: #ff9500;
  color: #fff;
}

.settings-btn {
  background-color: #8e8e93;
  color: #fff;
}

.btn:first-child {
  margin-left: 0;
}

.btn:last-child {
  margin-right: 0;
}
