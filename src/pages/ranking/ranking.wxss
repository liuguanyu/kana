/* pages/ranking/ranking.wxss */

.container {
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 头部 */
.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

/* 排序选项 */
.sort-options {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.sort-item {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 20rpx;
  border-radius: 5rpx;
  position: relative;
}

.sort-item.active {
  color: #4a6dff;
  font-weight: bold;
}

.sort-icon {
  margin-left: 5rpx;
}

/* 记录列表 */
.records-list {
  flex: 1;
  margin-bottom: 20rpx;
}

.record-item {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 15rpx;
}

.record-date {
  font-size: 24rpx;
  color: #999;
}

.record-delete {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.delete-icon {
  font-size: 28rpx;
  color: #999;
}

.record-content {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15rpx;
}

.record-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.stat-value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 清空记录按钮 */
.clear-button {
  text-align: center;
  padding: 20rpx;
  background-color: #ff3b30;
  color: #fff;
  border-radius: 10rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* 无记录提示 */
.no-records {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.no-records-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.start-test-btn {
  background-color: #4a6dff;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 10rpx;
}
